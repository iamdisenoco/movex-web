---
import Container3D from "../3d/Container3D";
---

<!-- MVP overlapping dark card with cinematic image, Viamaster headline split -->
<section id="logistica-digital" class="relative py-32 sm:py-48 px-6 lg:px-10">
  <div class="mx-auto max-w-7xl">
    <div class="relative rounded-[32px] overflow-hidden bg-navy-900">
      <!-- Cinematic background — parallax lento, opacidad subida para verse más -->
      <img
        src="/assets/images/04-digital-dashboard.jpg"
        alt=""
        data-parallax="0.15"
        class="absolute inset-0 size-full object-cover opacity-85"
        loading="lazy"
      />
      <!-- Overlay más liviano para que se vea más la imagen -->
      <div class="absolute inset-0 bg-gradient-to-tr from-navy-900/85 via-navy-900/45 to-navy-900/60"></div>

      <!-- Radar grid -->
      <div class="absolute inset-0 [background:radial-gradient(circle_at_70%_50%,transparent_0%,#1a2940_70%),repeating-radial-gradient(circle_at_70%_50%,rgba(45,138,138,0.08)_0,rgba(45,138,138,0.08)_1px,transparent_1px,transparent_60px)]"></div>

      <!--
        Contenedor 3D — derecha. Canvas con alpha transparente, drop-shadow
        teal para integrarlo con el bg cinematográfico. En mobile se oculta
        para no romper el layout vertical.
      -->
      <div
        class="hidden lg:block absolute right-0 top-1/2 -translate-y-1/2 w-[55%] h-[90%] z-0"
        style="filter: drop-shadow(0 30px 50px rgba(45,138,138,0.25));"
      >
        <Container3D
          client:only="react"
          variant="digital"
          dataPoints
          mouseParallax={false}
          autoRotate
        />
      </div>

      <!--
        Dashboard holográfico HTML overlay — 3 data-cards flotantes a la
        derecha del contenedor 3D, posicionadas absolute. Cada una con datos
        mock que pulsan / cuentan. Refuerza el "Tu carga, en tiempo real."
      -->
      <div
        class="hidden lg:block absolute right-10 top-16 z-20 space-y-4 pointer-events-none"
      >
        <!-- Card: tracking -->
        <div class="rounded-2xl bg-navy-900/55 backdrop-blur-md border border-teal-300/25 px-5 py-4 w-[230px] shadow-[0_0_30px_rgba(45,138,138,0.18)]">
          <div class="flex items-center gap-2 text-[9px] font-mono uppercase tracking-[0.25em] text-teal-300/85 mb-2">
            <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
            Tracking · MVXU 250624
          </div>
          <div class="text-white text-xl font-display tabular-nums">
            <span data-livecounter data-from="3741" data-to="3768">3,768</span><span class="text-white/40 text-sm ml-1">km</span>
          </div>
          <div class="text-white/55 text-[11px] mt-0.5">desde Apartadó</div>
        </div>

        <!-- Card: cadena de frío -->
        <div class="rounded-2xl bg-navy-900/55 backdrop-blur-md border border-teal-300/25 px-5 py-4 w-[230px] shadow-[0_0_30px_rgba(45,138,138,0.18)]">
          <div class="flex items-center gap-2 text-[9px] font-mono uppercase tracking-[0.25em] text-teal-300/85 mb-2">
            <span class="size-1.5 rounded-full bg-sage-light animate-pulse"></span>
            Cadena de frío
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-white text-xl font-display tabular-nums" data-livecounter data-from="-18.0" data-to="-18.4" data-decimals="1">
              -18.4
            </span>
            <span class="text-white/40 text-sm">°C</span>
            <span class="text-sage-light text-[10px] font-mono ml-auto">OK</span>
          </div>
          <div class="text-white/55 text-[11px] mt-0.5">target: -18°C ±2°</div>
        </div>

        <!-- Card: ETA -->
        <div class="rounded-2xl bg-navy-900/55 backdrop-blur-md border border-teal-300/25 px-5 py-4 w-[230px] shadow-[0_0_30px_rgba(45,138,138,0.18)]">
          <div class="flex items-center gap-2 text-[9px] font-mono uppercase tracking-[0.25em] text-teal-300/85 mb-2">
            <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
            ETA Rotterdam
          </div>
          <div class="text-white text-xl font-display tabular-nums">
            14d <span class="text-white/40 text-sm">06h</span>
          </div>
          <div class="text-white/55 text-[11px] mt-0.5">en tránsito · puntual</div>
        </div>
      </div>

      <div class="relative p-10 sm:p-16 lg:p-24 min-h-[60vh] flex flex-col justify-center z-10 lg:max-w-[55%]">
        <!-- Header strip -->
        <div class="flex justify-between items-center mb-12 text-[11px] font-mono uppercase tracking-[0.25em] text-white/55">
          <span class="flex items-center gap-2">
            <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
            Logística Digital
          </span>
          <span class="hidden sm:inline">Diferenciador Movex</span>
        </div>

        <!-- Title split — chars con stagger acumulativo -->
        <h2 class="font-display-xl text-[clamp(2.8rem,6.5vw,6.5rem)] text-white leading-[0.95] mb-10 max-w-4xl">
          <span data-split class="block">Tu carga,</span>
          <span data-split="slow" class="block text-teal-300 italic">visible</span>
          <span data-split class="block">en tiempo real.</span>
        </h2>

        <p data-reveal="up" style="--reveal-delay:200ms" class="text-base sm:text-lg leading-relaxed text-white/85 max-w-2xl mb-10">
          Digitalizamos cada etapa de tu operación: trazabilidad del servicio y de la carga,
          administración y auditoría de la cadena de frío, consultoría para el mejoramiento
          de procesos, tarja de mercancía, y diseño e implementación de software para tu
          operación. Toda la información, en tiempo real, desde un solo panel.
        </p>

        <div class="flex flex-wrap gap-4">
          <a href="#contacto" class="inline-flex items-center justify-center min-w-[200px] rounded-full bg-teal-500 hover:bg-teal-300 text-navy-900 font-semibold px-7 py-4 text-base transition-colors">
            Agendar una reunión
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Live counters jitter — cada N segundos, anima entre data-from y data-to
  // dando sensación de "datos en vivo" sin necesidad de backend.
  (() => {
    const els = document.querySelectorAll<HTMLElement>('[data-livecounter]');
    if (!els.length) return;
    const updateOne = (el: HTMLElement) => {
      const from = parseFloat(el.dataset.from || '0');
      const to = parseFloat(el.dataset.to || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const target = from + Math.random() * (to - from);
      const start = parseFloat(el.textContent?.replace(/[^\d.-]/g, '') || String(from));
      const duration = 800;
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / duration);
        const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        const val = start + (target - start) * eased;
        const formatted = decimals > 0
          ? val.toFixed(decimals)
          : Math.round(val).toLocaleString();
        // Conservar el span hijo (unidad) si existía — pero más simple: textContent
        el.textContent = formatted;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    setInterval(() => els.forEach(updateOne), 3500);
  })();
</script>
