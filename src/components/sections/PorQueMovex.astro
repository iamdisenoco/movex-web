---
// Por qué Movex — sección independiente (separada de QuienesSomos el
// 2026-07-13 para poder ordenarla DESPUÉS de Servicios).
// Foto del operario Movex de fondo + overlay navy (mismo patrón del hero).

const advantages = [
  { title: "Conocimiento y tradición", body: "de operaciones logísticas y portuarias construida sobre décadas de experiencia." },
  { title: "Apoyo tecnológico", body: "y diseño de software a medida integrado a cada eslabón de la operación." },
  { title: "Seguridad operativa", body: "criterios rigurosos aplicados en toda la cadena logística." },
  { title: "SST estructurada", body: "operaciones diseñadas bajo estándares de seguridad y salud en el trabajo." },
  { title: "Asesoría experta", body: "en procesos logísticos para optimizar tu operación integral." },
  { title: "Personal calificado", body: "y capacitado con experiencia comprobada en operaciones." },
];
---

<section
  id="por-que-movex"
  class="relative isolate overflow-hidden bg-navy-900 text-white pt-24 sm:pt-32 pb-32 sm:pb-40"
>
  <!-- Foto de fondo -->
  <img
    src="/assets/images/porque-movex-operario.jpg"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 size-full object-cover -z-20"
    loading="lazy"
  />
  <!-- Overlay degradado: izquierda más oscura (título), derecha algo más limpia -->
  <div
    class="absolute inset-0 -z-10 [background:linear-gradient(95deg,rgba(26,41,64,0.92)_0%,rgba(26,41,64,0.78)_35%,rgba(26,41,64,0.60)_65%,rgba(26,41,64,0.70)_100%)]"
    aria-hidden="true"
  ></div>
  <!-- Capa global para bajar contraste de la foto -->
  <div class="absolute inset-0 -z-10 bg-navy-900/30" aria-hidden="true"></div>

  <!-- Letra decorativa "POR QUÉ" sobre la foto -->
  <div
    aria-hidden="true"
    data-parallax="0.3"
    class="absolute top-10 -left-4 pointer-events-none select-none font-display-xl text-[clamp(8rem,22vw,22rem)] leading-[0.8] text-white/[0.05] whitespace-nowrap"
  >
    POR QUÉ
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <!-- Header: solo título -->
    <div data-reveal="left" class="mb-12 sm:mb-16">
      <div class="text-[11px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-6">
        ● Por qué Movex
      </div>
      <h2 data-split class="font-display-xl text-[clamp(2.5rem,5.5vw,5rem)] text-white leading-[0.8]">
        Por qué <span class="text-teal-300">Movex.</span>
      </h2>
    </div>

    <!-- Grid 3x2 de ventajas glass sobre la foto -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {advantages.map((adv, i) => (
        <article data-reveal="up" style={`--reveal-delay:${i * 60}ms`} class="rounded-3xl bg-white/5 border border-white/15 backdrop-blur-sm p-6 sm:p-8 hover:bg-white/10 transition-colors">
          <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-4">
            0{i + 1}/0{advantages.length}
          </div>
          <h3 class="font-display text-xl sm:text-2xl text-white leading-tight mb-3">
            {adv.title}
          </h3>
          <p class="text-sm sm:text-base text-white/85 leading-relaxed">
            {adv.body}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
