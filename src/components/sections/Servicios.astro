---
import { services } from "../../data/site";

// Descripción corta por servicio (va en el panel del tab).
const descriptions: Record<string, string> = {
  terrestres:
    "Carga, descarga y consolidación de contenedores y mercancía en tierra firme.",
  portuarias:
    "Estiba, desestiba y conexión de contenedores a bordo y en muelle.",
  digital:
    "Tecnología propia que mejora procesos, reduce tiempos y entrega información en línea con exactitud.",
  global:
    "Coordinación marítima, terrestre y aduanera para carga internacional.",
  alquiler:
    "Equipos especializados de manipulación, seguridad y mantenimiento portuario.",
};

// Descripción larga (opcional, reemplaza a la corta en el panel).
const longDescriptions: Record<string, string> = {
  digital:
    "Nos enfocamos en desarrollar y aplicar soluciones tecnológicas para mejorar procesos y reducir tiempos en labores operativas y administrativas, buscando reportes en línea y exactitud en la información.",
};

const totalServicios = services.length;
---

<!--
  Servicios — Tabs (rediseño 2026-07-13, estilo Maersk):
  -------------------------------------------------------
  Reemplaza el grid de cards con 5 fotos que se sentía muy cargado.
  Un servicio a la vez: tabs pills arriba, panel con imagen + título +
  descripción + items abajo. JS con event delegation togglea los panels.

  El modal anterior se eliminó — los items completos ahora se ven
  directamente en el panel de cada tab.
-->
<section
  id="servicios"
  class="relative z-20 text-white bg-navy-900 pt-24 sm:pt-32 lg:pt-40 pb-32 lg:pb-48 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
  <div class="relative mx-auto max-w-6xl">
    <!-- Pill "● Servicios" — SIEMPRE visible, no se colapsa -->
    <div class="flex justify-center mb-4">
      <div class="text-[11px] font-mono uppercase tracking-[0.3em] text-teal-300 inline-flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
        Servicios
      </div>
    </div>

    <!-- Header colapsable — se pliega al click en un tab, reaparece al
         hacer click fuera de los tabs / panel -->
    <div id="servicios-header" class="flex flex-col items-center text-center mb-12 sm:mb-16">
      <h2 class="font-display-xl text-[clamp(2.5rem,5vw,5rem)] leading-[0.95] max-w-4xl">
        <span data-split>Nuestros </span><span data-split="slow" class="text-teal-300">servicios.</span>
      </h2>
      <p data-reveal="up" style="--reveal-delay:150ms" class="mt-6 text-base sm:text-lg text-white/70 max-w-xl">
        Soluciones integradas para operar tu carga en puertos y terminales:
        cargue, descargue y todo lo que hay en medio.
      </p>
    </div>

    <!-- Tabs pills -->
    <div
      role="tablist"
      aria-label="Servicios Movex"
      class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-10 sm:mb-14"
    >
      {services.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${s.id}`}
          aria-controls={`panel-${s.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          data-service-tab={s.id}
          class={`rounded-full px-5 sm:px-7 py-2.5 text-sm sm:text-base font-medium transition-all duration-300 cursor-pointer ${
            i === 0
              ? "bg-teal-500 text-white"
              : "bg-transparent border border-white/25 text-white/75 hover:border-teal-300 hover:text-white"
          }`}
        >
          {s.title}
        </button>
      ))}
    </div>

    <!-- Panels -->
    <div class="relative">
      {services.map((s, i) => {
        const desc = longDescriptions[s.id] || descriptions[s.id] || "";
        return (
          <div
            role="tabpanel"
            id={`panel-${s.id}`}
            aria-labelledby={`tab-${s.id}`}
            data-service-panel={s.id}
            class={`mvx-tab-panel grid lg:grid-cols-[1fr_1.2fr] gap-8 lg:gap-12 items-start ${i === 0 ? "" : "hidden"}`}
          >
            <!-- Imagen del servicio -->
            <div class="relative aspect-[4/3] rounded-3xl overflow-hidden bg-navy-700 lg:sticky lg:top-28">
              <img
                src={s.image}
                alt={s.title}
                class="absolute inset-0 size-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-900/70 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-5 left-5 text-[10px] font-mono uppercase tracking-[0.25em] text-white/75">
                0{i + 1} / 0{totalServicios}
              </div>
            </div>

            <!-- Contenido -->
            <div>
              <h3 class="font-display-xl text-[clamp(1.8rem,3.5vw,3rem)] text-white leading-[0.95] mb-5">
                {s.title}
              </h3>
              <p class="text-base sm:text-lg text-white/80 leading-relaxed mb-8">
                {desc}
              </p>
              <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-4">
                Servicios incluidos
              </div>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-sm sm:text-base text-white/85 mb-10">
                {s.items.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-2 size-1.5 rounded-full bg-teal-300 flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a
                href="#contacto"
                class="inline-flex items-center gap-2 rounded-full bg-teal-500 hover:bg-teal-300 text-white font-semibold px-7 py-3.5 text-sm transition-colors"
              >
                Cotizar este servicio
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Fade-in suave del panel al cambiar de tab */
  .mvx-tab-panel:not(.hidden) {
    animation: panel-in 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Header colapsable: al hacer click en un tab se pliega suavemente
     para descargar la vista. max-height alto para no cortar el contenido
     antes del colapso. */
  #servicios-header {
    max-height: 500px;
    overflow: hidden;
    transition:
      max-height 600ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 450ms ease,
      margin-bottom 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  #servicios-header.collapsed {
    max-height: 0;
    opacity: 0;
    margin-bottom: 0;
  }
</style>

<script>
  // Tabs de Servicios — event delegation (robusto sin importar cuándo
  // corra el script). Click en un tab → activa su panel, desactiva el resto.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const tab = target.closest<HTMLElement>("[data-service-tab]");

    if (!tab) {
      // Click FUERA de los tabs: si tampoco fue dentro del panel activo,
      // volver a mostrar el header "Nuestros servicios."
      const insideServicios =
        target.closest("[data-service-panel]") || target.closest("[role='tablist']");
      if (!insideServicios) {
        document.getElementById("servicios-header")?.classList.remove("collapsed");
      }
      return;
    }
    const id = tab.dataset.serviceTab;
    if (!id) return;

    // Colapsar el header "Nuestros servicios." al click en un tab
    document.getElementById("servicios-header")?.classList.add("collapsed");

    // Tabs: estilos activo/inactivo
    document.querySelectorAll<HTMLElement>("[data-service-tab]").forEach((t) => {
      const isActive = t === tab;
      t.setAttribute("aria-selected", isActive ? "true" : "false");
      t.classList.toggle("bg-teal-500", isActive);
      t.classList.toggle("text-white", isActive);
      t.classList.toggle("bg-transparent", !isActive);
      t.classList.toggle("border", !isActive);
      t.classList.toggle("border-white/25", !isActive);
      t.classList.toggle("text-white/75", !isActive);
    });

    // Panels: mostrar solo el del tab clickeado
    document.querySelectorAll<HTMLElement>("[data-service-panel]").forEach((p) => {
      p.classList.toggle("hidden", p.dataset.servicePanel !== id);
    });
  });
</script>
