---
import { services } from "../../data/site";
const total = services.length;
---

<!--
  Servicios — Card Stack scroll-driven (rediseño 2026-05-26):
  ------------------------------------------------------------
  Cambios pedidos por Jon:
    1. Más diseños/decoraciones para que no quede plano cuando la letra
       "SERVICIOS GLOBALES" se va. Watermark gigante de número activo
       cambia con cada card + segunda letra deco "GLOBAL" abajo.
    2. Hold/respiración en cada card cuando está centrada (easing pow 2.2
       en animation.ts → la card vive en su posición ~30-40% del slot).
    3. Imágenes con Ken Burns continuo (scale 1 → 1.08 → 1) — siempre
       animadas, se ven cuando son la activa (opacity 1).
    4. Título de cada servicio GRANDE sobre la imagen izquierda; sólo
       descripción/lista a la derecha.
-->
<section
  id="servicios"
  data-card-stack
  data-card-stack-count={total}
  class="relative z-20 text-white -mt-[12vh]"
  style={`height: ${(total + 1) * 100}vh`}
>
  <!-- Decorative giant bg headline ARRIBA — la letra que ya teníamos -->
  <div
    aria-hidden="true"
    class="pointer-events-none select-none absolute top-12 left-0 right-0 z-0 overflow-hidden"
  >
    <div
      data-parallax="0.3"
      class="font-display-xl text-[clamp(8rem,22vw,22rem)] leading-none text-white/[0.03] whitespace-nowrap pl-6 lg:pl-10"
    >
      SERVICIOS GLOBALES
    </div>
  </div>

  <!-- Segunda letra deco — entra desde abajo cuando "SERVICIOS GLOBALES"
       ya se fue. Da continuidad visual durante el card stack. -->
  <div
    aria-hidden="true"
    class="pointer-events-none select-none absolute bottom-12 left-0 right-0 z-0 overflow-hidden"
  >
    <div
      data-parallax="0.45"
      class="font-display-xl text-[clamp(8rem,22vw,22rem)] leading-none text-teal-300/[0.05] whitespace-nowrap text-right pr-6 lg:pr-10 italic"
    >
      WORLDWIDE
    </div>
  </div>

  <!-- Background dots pattern — sutil grid de puntos teal animados.
       Vive dentro del sticky stage para mantenerse visible durante
       todo el card stack (no se va con el scroll). -->
  <div
    aria-hidden="true"
    class="absolute inset-0 z-0 pointer-events-none opacity-25 [background-image:radial-gradient(circle,rgba(95,179,179,0.18)_1px,transparent_1px)] [background-size:32px_32px]"
  ></div>

  <!-- Sticky stage: queda fijo durante todo el pin space -->
  <div class="sticky top-0 h-screen overflow-hidden flex items-center justify-center px-4 sm:px-8 lg:px-12">
    <!-- CUADRO AZUL: container narrow centered con bg navy + radius -->
    <div class="relative w-full max-w-6xl bg-navy-900 rounded-[24px] sm:rounded-[28px] shadow-[0_-20px_60px_rgba(0,0,0,0.4),0_30px_80px_rgba(0,0,0,0.3)] px-6 sm:px-10 lg:px-14 py-10 sm:py-14 lg:py-16 h-[clamp(620px,84vh,840px)] overflow-hidden flex flex-col justify-center">
      <!-- Watermark del número activo — gigante atrás del card, cambia
           con la card activa. Da variación visual por card. -->
      <div
        aria-hidden="true"
        class="absolute -bottom-12 -right-6 pointer-events-none select-none font-display-xl text-[clamp(10rem,26vw,26rem)] leading-[0.8] text-white/[0.04] whitespace-nowrap"
      >
        <span data-stack-watermark>0{1}</span>
      </div>

      <!-- Header strip -->
      <div class="relative flex justify-between items-center mb-6 text-[11px] font-mono uppercase tracking-[0.25em] text-white/55">
        <span class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
          Servicios
        </span>
        <span class="hidden sm:inline" data-stack-counter>01 / 0{total}</span>
      </div>

      <!-- Title compacto de la sección (queda fijo) -->
      <h2 class="relative font-display-xl text-[clamp(2rem,4.5vw,4rem)] text-white leading-[0.95] mb-8 max-w-3xl">
        <span data-split class="block">Nuestros</span>
        <span data-split="slow" class="block text-teal-300">servicios.</span>
      </h2>

      <!-- Grid principal: imagen+título a la izquierda (más peso 1.4fr) +
           descripción/lista a la derecha (1fr). Altura aumentada para
           respiración del nuevo layout. -->
      <div class="relative grid lg:grid-cols-[1.4fr_1fr] gap-6 lg:gap-10 items-stretch h-[clamp(400px,55vh,580px)]">
        <!-- IZQUIERDA: imagen con título overlay GRANDE -->
        <div class="relative aspect-[4/3] lg:aspect-auto rounded-3xl overflow-hidden bg-navy-700">
          <!-- Stack de imágenes (todas absolute, JS toggle opacity) -->
          {services.map((s, i) => (
            <img
              src={s.image}
              alt={s.title}
              data-stack-image={i}
              class={`mvx-ken-burns absolute inset-0 size-full object-cover transition-opacity duration-500 ${i === 0 ? "opacity-100" : "opacity-0"}`}
              loading="lazy"
            />
          ))}
          <!-- Overlay degradado para legibilidad del título -->
          <div class="absolute inset-0 bg-gradient-to-t from-navy-900/85 via-navy-900/30 to-navy-900/20 pointer-events-none"></div>

          <!-- Counter chico arriba-izquierda -->
          <div class="absolute top-6 left-6 font-mono text-[10px] tracking-[0.25em] text-white/75" data-stack-image-counter>
            01<span class="text-white/40">/0{total}</span>
          </div>

          <!-- STACK DE TÍTULOS GRANDES — overlay sobre imagen, abajo-izquierda.
               Cada uno tiene opacity 0/1 controlada por JS (igual que imágenes). -->
          {services.map((s, i) => (
            <div
              data-stack-title={i}
              class={`absolute bottom-6 left-6 right-6 transition-opacity duration-500 ${i === 0 ? "opacity-100" : "opacity-0"}`}
            >
              {(s as any).featured === true && (
                <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-3 inline-flex items-center gap-2 rounded-full bg-teal-300/15 backdrop-blur px-3 py-1">
                  ★ Diferenciador Movex
                </div>
              )}
              <h3 class="font-display-xl text-[clamp(2rem,4.5vw,3.5rem)] text-white leading-[0.95] drop-shadow-[0_4px_24px_rgba(0,0,0,0.6)]">
                {s.title}
              </h3>
            </div>
          ))}
        </div>

        <!-- DERECHA: stack de cards con sólo descripción/items (sin título) -->
        <div class="relative">
          {services.map((s, i) => {
            const isAccent = i % 2 === 1;
            return (
              <article
                data-stack-card={i}
                style={`--stack-i:${i}; --stack-total:${total}; transform: translate3d(0, ${i === 0 ? "0%" : "100%"}, 0); opacity: ${i === 0 ? 1 : 0}; z-index: ${100 - i};`}
                class={`absolute inset-0 rounded-3xl p-8 sm:p-10 flex flex-col gap-5 will-change-transform transition-opacity duration-500 ${isAccent ? "bg-navy-700 text-white" : "bg-white text-navy-900"}`}
              >
                <!-- Header chiquito: número 0X/0total + label "servicios incluidos" -->
                <div class={`flex items-center justify-between text-[10px] font-mono uppercase tracking-[0.25em] ${isAccent ? "text-teal-300" : "text-teal-500"}`}>
                  <span>0{i + 1} / 0{total}</span>
                  <span class={isAccent ? "text-white/55" : "text-navy-500"}>Servicios incluidos</span>
                </div>

                <!-- Lista de items -->
                <ul class={`grid grid-cols-1 sm:grid-cols-2 gap-y-2.5 gap-x-6 text-sm sm:text-base ${isAccent ? "text-white/90" : "text-navy-700"}`}>
                  {s.items.slice(0, 10).map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class={`mt-2 size-1 rounded-full flex-shrink-0 ${isAccent ? "bg-teal-300" : "bg-teal-500"}`}></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </div>

    </div><!-- /cuadro azul -->
  </div><!-- /sticky stage -->
</section>
