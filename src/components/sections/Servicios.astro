---
import { services } from "../../data/site";

// Descripción corta por servicio (1 línea, didáctica). NO modifica site.ts —
// la descripción se asocia por ID. Si el servicio no tiene descripción,
// fallback a join de los primeros 3 items.
const descriptions: Record<string, string> = {
  terrestres:
    "Carga, descarga y consolidación de contenedores y mercancía en tierra firme.",
  portuarias:
    "Estiba, desestiba y conexión de contenedores a bordo y en muelle.",
  digital:
    "Trazabilidad, auditoría y software a medida para tu operación logística.",
  global:
    "Coordinación marítima, terrestre y aduanera para carga internacional.",
  alquiler:
    "Equipos especializados de manipulación, seguridad y mantenimiento portuario.",
};

const totalServicios = services.length;
---

<!--
  Servicios — Grid 2 columnas (rediseño 2026-05-29):
  ---------------------------------------------------
  Reemplaza el bento complejo anterior. Cards grandes, didácticas, espaciadas.
  Estilo inspirado en DSV / Maersk: cada card respira, foto domina, texto mínimo.

  Layout:
    Row 1: Terrestres,  Portuarias    (2 cols)
    Row 2: Digital (featured, full width — span 2 cols con badge)
    Row 3: Global,      Alquiler      (2 cols)

  Cada card:
    - Imagen full-bleed con overlay degradado bottom-up
    - Título grande sobre la imagen
    - 1 línea de descripción
    - "Conocer más →" link al final
    - Hover: lift + zoom sutil de imagen
-->
<section
  id="servicios"
  class="relative z-20 text-white -mt-[12vh] bg-navy-900 rounded-t-[40px] sm:rounded-t-[60px] shadow-[0_-20px_60px_rgba(0,0,0,0.4)] pt-24 sm:pt-32 lg:pt-40 pb-32 lg:pb-48 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
  <div class="relative mx-auto max-w-7xl">
    <!-- Header -->
    <div class="flex flex-col items-center text-center mb-16 sm:mb-20">
      <div class="text-[11px] font-mono uppercase tracking-[0.3em] text-teal-300 mb-4 inline-flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
        Servicios
      </div>
      <h2 class="font-display-xl text-[clamp(2.5rem,5vw,5rem)] leading-[0.95] max-w-4xl">
        <span data-split>Nuestros </span><span data-split="slow" class="text-teal-300">servicios.</span>
      </h2>
      <p data-reveal="up" style="--reveal-delay:150ms" class="mt-6 text-base sm:text-lg text-white/70 max-w-xl">
        Cinco verticales integradas para mover tu carga desde y hacia cualquier
        parte del mundo.
      </p>
    </div>

    <!-- Grid de servicios: 2 cols, featured ocupa fila completa -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 lg:gap-8">
      {services.map((s, i) => {
        const isFeatured = (s as any).featured === true;
        const desc = descriptions[s.id] || s.items.slice(0, 3).join(" · ");
        return (
          <article
            data-reveal="up"
            style={`--reveal-delay:${i * 80}ms`}
            class={`group relative rounded-3xl overflow-hidden bg-navy-700 transition-all duration-500 hover:scale-[1.015] hover:shadow-[0_30px_80px_rgba(0,0,0,0.5)] ${isFeatured ? "lg:col-span-2 aspect-[2.4/1]" : "aspect-[4/3] sm:aspect-[5/3]"}`}
          >
            <!-- Imagen de fondo -->
            <img
              src={s.image}
              alt={s.title}
              class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <!-- Overlay degradado para legibilidad: oscuro abajo, claro arriba -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/55 to-navy-900/10 pointer-events-none"></div>

            <!-- Badge "Diferenciador" en featured -->
            {isFeatured && (
              <div class="absolute top-6 left-6 sm:top-8 sm:left-8 inline-flex items-center gap-2 rounded-full bg-teal-300/15 backdrop-blur px-4 py-1.5 text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300">
                ★ Diferenciador Movex
              </div>
            )}

            <!-- Counter -->
            <div class="absolute top-6 right-6 sm:top-8 sm:right-8 text-[10px] font-mono uppercase tracking-[0.25em] text-white/55">
              0{i + 1} / 0{totalServicios}
            </div>

            <!-- Contenido textual: abajo, izquierda -->
            <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 lg:p-10">
              <h3 class={`font-display-xl text-white leading-[0.95] mb-3 ${isFeatured ? "text-[clamp(2rem,4vw,3.5rem)]" : "text-[clamp(1.5rem,2.5vw,2.5rem)]"}`}>
                {s.title}
              </h3>
              <p class={`text-white/80 leading-relaxed mb-5 ${isFeatured ? "text-base sm:text-lg max-w-2xl" : "text-sm sm:text-base max-w-md"}`}>
                {desc}
              </p>
              <a
                href="#contacto"
                class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.2em] text-teal-300 hover:text-white transition-colors"
              >
                Conocer más
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
