---
import { services } from "../../data/site";

// Descripción corta por servicio (1 línea, didáctica). NO modifica site.ts —
// la descripción se asocia por ID. Si el servicio no tiene descripción,
// fallback a join de los primeros 3 items.
const descriptions: Record<string, string> = {
  terrestres:
    "Carga, descarga y consolidación de contenedores y mercancía en tierra firme.",
  portuarias:
    "Estiba, desestiba y conexión de contenedores a bordo y en muelle.",
  digital:
    "Trazabilidad, auditoría y software a medida para tu operación logística.",
  global:
    "Coordinación marítima, terrestre y aduanera para carga internacional.",
  alquiler:
    "Equipos especializados de manipulación, seguridad y mantenimiento portuario.",
};

const totalServicios = services.length;
---

<!--
  Servicios — Grid 2 columnas (rediseño 2026-05-29):
  ---------------------------------------------------
  Reemplaza el bento complejo anterior. Cards grandes, didácticas, espaciadas.
  Estilo inspirado en DSV / Maersk: cada card respira, foto domina, texto mínimo.

  Layout:
    Row 1: Terrestres,  Portuarias    (2 cols)
    Row 2: Digital (featured, full width — span 2 cols con badge)
    Row 3: Global,      Alquiler      (2 cols)

  Cada card:
    - Imagen full-bleed con overlay degradado bottom-up
    - Título grande sobre la imagen
    - 1 línea de descripción
    - "Conocer más →" link al final
    - Hover: lift + zoom sutil de imagen
-->
<section
  id="servicios"
  class="relative z-20 text-white -mt-[12vh] bg-navy-900 rounded-t-[40px] sm:rounded-t-[60px] shadow-[0_-20px_60px_rgba(0,0,0,0.4)] pt-24 sm:pt-32 lg:pt-40 pb-32 lg:pb-48 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
  <div class="relative mx-auto max-w-7xl">
    <!-- Header -->
    <div class="flex flex-col items-center text-center mb-16 sm:mb-20">
      <div class="text-[11px] font-mono uppercase tracking-[0.3em] text-teal-300 mb-4 inline-flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-teal-300 animate-pulse"></span>
        Servicios
      </div>
      <h2 class="font-display-xl text-[clamp(2.5rem,5vw,5rem)] leading-[0.95] max-w-4xl">
        <span data-split>Nuestros </span><span data-split="slow" class="text-teal-300">servicios.</span>
      </h2>
      <p data-reveal="up" style="--reveal-delay:150ms" class="mt-6 text-base sm:text-lg text-white/70 max-w-xl">
        Cinco verticales integradas para mover tu carga desde y hacia cualquier
        parte del mundo.
      </p>
    </div>

    <!-- Grid de servicios: 2 cols, featured ocupa fila completa -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 lg:gap-8">
      {services.map((s, i) => {
        const isFeatured = (s as any).featured === true;
        const desc = descriptions[s.id] || s.items.slice(0, 3).join(" · ");
        return (
          <article
            data-reveal="up"
            data-modal-open={`modal-${s.id}`}
            style={`--reveal-delay:${i * 80}ms`}
            class={`group relative rounded-3xl overflow-hidden bg-navy-700 transition-all duration-500 hover:scale-[1.015] hover:shadow-[0_30px_80px_rgba(0,0,0,0.5)] cursor-pointer ${isFeatured ? "lg:col-span-2 aspect-[2.4/1]" : "aspect-[4/3] sm:aspect-[5/3]"}`}
          >
            <!-- Imagen de fondo -->
            <img
              src={s.image}
              alt={s.title}
              class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <!-- Overlay degradado para legibilidad: oscuro abajo, claro arriba -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/55 to-navy-900/10 pointer-events-none"></div>

            <!-- Badge "Diferenciador" en featured -->
            {isFeatured && (
              <div class="absolute top-6 left-6 sm:top-8 sm:left-8 inline-flex items-center gap-2 rounded-full bg-teal-300/15 backdrop-blur px-4 py-1.5 text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300">
                ★ Diferenciador Movex
              </div>
            )}

            <!-- Counter -->
            <div class="absolute top-6 right-6 sm:top-8 sm:right-8 text-[10px] font-mono uppercase tracking-[0.25em] text-white/55">
              0{i + 1} / 0{totalServicios}
            </div>

            <!-- Contenido textual: abajo, izquierda -->
            <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 lg:p-10">
              <h3 class={`font-display-xl text-white leading-[0.95] mb-3 ${isFeatured ? "text-[clamp(2rem,4vw,3.5rem)]" : "text-[clamp(1.5rem,2.5vw,2.5rem)]"}`}>
                {s.title}
              </h3>
              <p class={`text-white/80 leading-relaxed mb-5 ${isFeatured ? "text-base sm:text-lg max-w-2xl" : "text-sm sm:text-base max-w-md"}`}>
                {desc}
              </p>
              <button
                type="button"
                data-modal-open={`modal-${s.id}`}
                class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-[0.2em] text-teal-300 hover:text-white transition-colors cursor-pointer"
              >
                Conocer más
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </button>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- MODALES de cada servicio: lista completa de items, abre al click "Conocer más" -->
  {services.map((s, i) => {
    const isFeatured = (s as any).featured === true;
    const desc = descriptions[s.id] || s.items.slice(0, 3).join(" · ");
    return (
      <dialog
        id={`modal-${s.id}`}
        class="mvx-service-modal fixed inset-0 z-50 max-w-3xl w-full sm:w-[92vw] max-h-[88vh] m-auto rounded-3xl bg-navy-900 text-white p-0 overflow-hidden flex-col backdrop:bg-black/70 backdrop:backdrop-blur-sm"
      >
        <!-- Header con imagen de fondo (shrink-0 = altura fija) -->
        <div class="relative aspect-[16/7] sm:aspect-[16/6] shrink-0 overflow-hidden">
          <img src={s.image} alt={s.title} class="absolute inset-0 size-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/40 to-navy-900/20"></div>
          {isFeatured && (
            <div class="absolute top-6 left-6 inline-flex items-center gap-2 rounded-full bg-teal-300/15 backdrop-blur px-4 py-1.5 text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300">
              ★ Diferenciador Movex
            </div>
          )}
          <button
            type="button"
            data-modal-close={`modal-${s.id}`}
            aria-label="Cerrar"
            class="absolute top-4 right-4 sm:top-6 sm:right-6 size-10 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur flex items-center justify-center text-white transition-colors"
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
            </svg>
          </button>
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
            <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-2">
              ● Servicio 0{i + 1} / 0{totalServicios}
            </div>
            <h3 class="font-display-xl text-[clamp(1.8rem,3.5vw,3rem)] text-white leading-[0.95]">
              {s.title}
            </h3>
          </div>
        </div>

        <!-- Body scrollable: solo descripción + items. CTA queda FUERA abajo. -->
        <div class="p-6 sm:p-8 overflow-y-auto min-h-0 flex-1">
          <p class="text-base sm:text-lg text-white/85 leading-relaxed mb-8">
            {desc}
          </p>
          <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-4">
            Servicios incluidos
          </div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm sm:text-base text-white/85">
            {s.items.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 size-1.5 rounded-full bg-teal-300 flex-shrink-0"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Footer FIJO: CTA siempre visible aunque la lista sea larga -->
        <div class="shrink-0 px-6 sm:px-8 py-5 border-t border-white/10 bg-navy-900 flex flex-wrap gap-3 items-center justify-between">
          <span class="text-sm text-white/55">¿Necesitas más detalles?</span>
          <a
            href="#contacto"
            data-modal-close={`modal-${s.id}`}
            class="inline-flex items-center gap-2 rounded-full bg-teal-500 hover:bg-teal-300 text-white font-semibold px-6 py-3 text-sm transition-colors"
          >
            Cotizar este servicio
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </dialog>
    );
  })}
</section>

<style>
  /* Animación de entrada del dialog + flex column layout para que el footer
     (CTA) quede sticky abajo sin importar el largo de la lista de items.
     <dialog> tiene display:block por default cuando está abierto — hay que
     forzar flex para que el body con flex-1 + overflow-y-auto funcione. */
  .mvx-service-modal[open] {
    display: flex;
    flex-direction: column;
    animation: modal-in 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mvx-service-modal[open]::backdrop {
    animation: backdrop-in 280ms ease-out;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  /* Cuando el modal está abierto, bloquear scroll del body */
  body:has(.mvx-service-modal[open]) {
    overflow: hidden;
  }
</style>

<script>
  // Modal handler con EVENT DELEGATION — funciona aunque el DOM cambie
  // o el script se ejecute antes/después de que los elementos existan.
  // Usa <dialog> nativo HTML5 (accesible, ESC + focus trap built-in).

  // OPEN: cualquier click en un elemento con data-modal-open
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const openBtn = target.closest<HTMLElement>("[data-modal-open]");
    if (openBtn) {
      e.preventDefault();
      const id = openBtn.dataset.modalOpen;
      if (!id) return;
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
      return;
    }

    // CLOSE: click en elemento con data-modal-close
    const closeBtn = target.closest<HTMLElement>("[data-modal-close]");
    if (closeBtn) {
      const id = closeBtn.dataset.modalClose;
      if (!id) return;
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      dialog?.close();
      return;
    }

    // CLOSE: click directo sobre el <dialog> (backdrop)
    if (target.tagName === "DIALOG" && target.classList.contains("mvx-service-modal")) {
      (target as HTMLDialogElement).close();
    }
  });
</script>
