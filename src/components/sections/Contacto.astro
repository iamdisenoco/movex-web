---
import { contact } from "../../data/site";
---

<!-- MVP-style giant card with form + sidebar -->
<section id="contacto" class="relative py-32 sm:py-48 px-6 lg:px-10">
  <div class="mx-auto max-w-7xl">
    <div class="relative rounded-[32px] bg-navy-700 text-white p-10 sm:p-16 lg:p-24 overflow-hidden">
      <!-- Decorative giant headline bg — parallax lento -->
      <div
        aria-hidden="true"
        data-parallax="0.3"
        class="absolute -right-10 bottom-6 text-[clamp(6rem,18vw,18rem)] leading-none font-display-xl text-white/[0.04] whitespace-nowrap select-none"
      >
        HABLEMOS
      </div>

      <!-- Header strip -->
      <div class="relative flex justify-between items-center mb-12 text-[11px] font-mono uppercase tracking-[0.25em] text-white/55">
        <span>● Contacto</span>
        <span class="hidden sm:inline">Apartadó · Santa Marta · World</span>
      </div>

      <h2 class="relative font-display-xl text-[clamp(2.8rem,6vw,6rem)] text-white leading-[0.95] mb-16 max-w-3xl">
        <span data-split class="block">Hablemos</span>
        <span data-split="slow" class="block italic text-teal-300">de tu carga.</span>
      </h2>

      <div class="relative grid lg:grid-cols-2 gap-12 lg:gap-20 lg:items-center">
        <!-- Form -->
        <form class="grid gap-5" onsubmit="event.preventDefault(); alert('Demo: formulario envía a backend en fase E2');">
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="grid gap-2">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/55">Nombre</span>
              <input type="text" required class="bg-navy-900/40 border border-white/15 rounded-xl px-4 py-3.5 text-white placeholder:text-white/30 focus:outline-none focus:border-teal-300" placeholder="Tu nombre" />
            </label>
            <label class="grid gap-2">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/55">Empresa</span>
              <input type="text" required class="bg-navy-900/40 border border-white/15 rounded-xl px-4 py-3.5 text-white placeholder:text-white/30 focus:outline-none focus:border-teal-300" placeholder="Tu empresa" />
            </label>
          </div>
          <div class="grid sm:grid-cols-2 gap-5">
            <label class="grid gap-2">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/55">Email</span>
              <input type="email" required class="bg-navy-900/40 border border-white/15 rounded-xl px-4 py-3.5 text-white placeholder:text-white/30 focus:outline-none focus:border-teal-300" placeholder="tu@empresa.com" />
            </label>
            <label class="grid gap-2">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/55">Teléfono</span>
              <input type="tel" class="bg-navy-900/40 border border-white/15 rounded-xl px-4 py-3.5 text-white placeholder:text-white/30 focus:outline-none focus:border-teal-300" placeholder="+57" />
            </label>
          </div>
          <label class="grid gap-2">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/55">Tipo de carga</span>
            <select class="bg-navy-900/40 border border-white/15 rounded-xl px-4 py-3.5 text-white focus:outline-none focus:border-teal-300">
              <option>General</option>
              <option>Refrigerada</option>
              <option>Granel</option>
              <option>Maquinaria</option>
              <option>Otra</option>
            </select>
          </label>
          <label class="grid gap-2">
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-white/55">Mensaje</span>
            <textarea rows="4" class="bg-navy-900/40 border border-white/15 rounded-xl px-4 py-3.5 text-white placeholder:text-white/30 focus:outline-none focus:border-teal-300 resize-none" placeholder="Cuéntanos qué carga tienes que mover."></textarea>
          </label>
          <button
            type="submit"
            data-magnetic
            data-ripple
            class="mvx-shimmer justify-self-start rounded-full bg-teal-500 hover:bg-teal-300 text-white font-semibold px-8 py-4 transition-colors mt-2"
          >
            <span class="font-display tracking-[0.04em] uppercase text-sm">Enviar solicitud</span>
          </button>
        </form>

        <!-- Contact info -->
        <div class="space-y-6">
          <!-- Teléfono -->
          <div class="rounded-2xl bg-navy-900/30 p-7">
            <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-3">
              Teléfono
            </div>
            <a href={`tel:${contact.tel}`} class="font-display text-2xl text-white hover:text-teal-300 transition-colors">
              {contact.tel}
            </a>
          </div>

          <!-- Email -->
          <div class="rounded-2xl bg-navy-900/30 p-7">
            <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-3">
              Email
            </div>
            <a href={`mailto:${contact.email}`} class="font-display text-xl sm:text-2xl text-white hover:text-teal-300 transition-colors break-all">
              {contact.email}
            </a>
          </div>

          <!-- WhatsApp directo -->
          <a
            href={`https://wa.me/${contact.whatsappRaw}`}
            target="_blank"
            rel="noopener"
            class="block rounded-2xl bg-teal-500/15 border border-teal-500/30 p-7 hover:bg-teal-500/20 transition-colors"
          >
            <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-2">WhatsApp directo</div>
            <span class="font-display text-2xl text-white">
              {contact.whatsapp}
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
