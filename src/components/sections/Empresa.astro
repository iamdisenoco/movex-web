---
import { counters } from "../../data/site";
---

<!--
  Empresa = el "card" que SUBE sobre el hero sticky (técnica MVP scroll-stacking):
  - El section MISMO es el card: bg-navy-900 + rounded-t-[40px] (esquinas en el top).
  - z-20 lo pone por encima del hero (z-0 sticky).
  - Conforme scrolleas, el hero sticky se queda pegado al top mientras este
    section SUBE desde abajo y va cubriendo al hero por completo.
  - Headline gigante "MÁS DE UNA DÉCADA" se posiciona en el bottom del section
    como decoración, asomando por encima del siguiente section.
-->
<!--
  Empresa con el mismo pattern del "cuadro azul" MVP:
  - <section> transparente, solo provee el flow.
  - DENTRO un wrapper max-w-6xl con bg navy + radius + shadow.
  - Los lados quedan visibles (se ve la section anterior detrás).
-->
<section
  id="empresa"
  class="relative z-20 px-4 sm:px-8 lg:px-12 pt-20 sm:pt-28 lg:pt-32 pb-32 sm:pb-48"
><!-- card wrapper —><div class="relative w-full max-w-6xl mx-auto bg-navy-900 rounded-[24px] sm:rounded-[28px] shadow-[0_-20px_60px_rgba(0,0,0,0.4),0_30px_80px_rgba(0,0,0,0.3)] px-6 sm:px-10 lg:px-14 py-12 sm:py-16 lg:py-20 overflow-hidden">
  <!-- Headline DECORATIVO gigante, asomando bajo el contenido -->
  <div
    aria-hidden="true"
    data-parallax="0.15"
    class="pointer-events-none select-none absolute left-0 right-0 bottom-12 px-6 lg:px-10 z-0"
  >
    <div class="mx-auto max-w-7xl">
      <div class="font-display-xl text-[clamp(5rem,15vw,15rem)] leading-[0.85] text-white/[0.06] whitespace-nowrap">
        MÁS DE UNA DÉCADA
      </div>
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <!-- Section header strip -->
    <div class="relative flex justify-between items-center mb-12 text-[11px] font-mono uppercase tracking-[0.25em] text-white/55">
      <span>● Empresa</span>
      <span class="hidden sm:inline">Movex Trans-Logistics</span>
    </div>

    <!-- Main content -->
    <div class="relative max-w-3xl">
      <h2 data-split class="font-display text-[clamp(2.5rem,6vw,5rem)] text-white mb-10">
        Movex Company.
      </h2>
      <div data-reveal="up" style="--reveal-delay:120ms" class="space-y-6 text-base sm:text-lg leading-relaxed text-white/85 mb-12">
        <p>
          Heredamos la experiencia operativa de <strong class="text-white">Cargoban</strong>,
          operador logístico portuario referente en el Caribe colombiano desde 2012.
          Movex extiende ese músculo a una escala internacional.
        </p>
        <p>
          Trabajamos en estiba, consolidación, trazabilidad digital y agenciamiento aduanero —
          manejando carga general, refrigerada, granel y proyectos especiales.
        </p>
      </div>

      <!-- CTA card, MVP style: large white card -->
      <a
        href="#quienes-somos"
        class="relative inline-flex items-center justify-center min-w-[280px] rounded-2xl bg-white hover:bg-gray-100 text-navy-900 font-semibold px-8 py-5 text-base transition-colors"
      >
        <span class="font-display tracking-[0.05em] uppercase text-sm">Conocer más sobre Movex</span>
      </a>
    </div>

    <!-- Counter grid: bottom, 4 columns of numeric metrics -->
    <div class="relative mt-20 pt-12 border-t border-white/10 grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-6">
      {counters.map((c, i) => {
        const numeric = parseInt(String(c.value).replace(/\D/g, ""), 10);
        const animatable = isFinite(numeric) && numeric > 0;
        return (
          <div data-reveal="up" style={`--reveal-delay:${i * 100}ms`}>
            <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-3">
              0{i + 1}
            </div>
            <div class="font-display text-4xl sm:text-5xl text-white mb-2">
              {animatable ? <span data-countup={numeric}>0</span> : c.value}
            </div>
            <div class="text-xs text-white/55 leading-relaxed">{c.label}</div>
          </div>
        );
      })}
    </div>
  </div><!-- /max-w-6xl mx-auto content wrap -->
  </div><!-- /card wrapper navy con radius -->
</section>
