---
import { counters } from "../../data/site";

const advantages = [
  { title: "20+ años", body: "de experiencia operativa heredada del grupo Cargoban." },
  { title: "Bodegas estratégicas", body: "en Apartadó y Santa Marta para logística ágil y eficiente." },
  { title: "Equipo propio", body: "logísticos experimentados controlando cada etapa." },
  { title: "Seguro de carga", body: "para máxima seguridad y tranquilidad operacional." },
];
---

<!-- MVP "Our Advantages" pattern: giant sticky title left + stacked cards right.
     data-nav-theme="dark" hace que el nav se invierta a oscuro sobre este bg
     blanco (sync via scroll spy en animation.ts). -->
<section id="quienes-somos" data-nav-theme="dark" class="relative bg-white text-navy-900 py-32 sm:py-48">

  <!-- INTRO BLOCK (movido desde Empresa): heritage + counters CON VIDEO DE FONDO -->
  <div class="relative isolate overflow-hidden mb-32 sm:mb-40 -mt-32 sm:-mt-48 pt-32 sm:pt-48 pb-24 sm:pb-32 bg-navy-900 text-white">
    <!-- Video de fondo. El #t=1.5 hace que empiece en segundo 1.5 (corta el principio).
         Sin loop nativo: el script más abajo loopea de 1.5s a final. -->
    <video
      id="quienes-somos-video"
      class="absolute inset-0 size-full object-cover -z-20 opacity-0 transition-opacity duration-700 ease-out"
      src="/assets/videos/contenedores-quienes-somos.mp4#t=1.5"
      autoplay
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
      data-start-time="1.5"
      onloadeddata="this.classList.remove('opacity-0')"
    ></video>
    <!-- Overlay degradado (mismo estilo que el hero: izq oscura, der un poco más limpia) -->
    <div
      class="absolute inset-0 -z-10 [background:linear-gradient(95deg,rgba(26,41,64,0.88)_0%,rgba(26,41,64,0.70)_30%,rgba(26,41,64,0.55)_60%,rgba(26,41,64,0.65)_100%)]"
      aria-hidden="true"
    ></div>
    <!-- Capa global navy/30 -->
    <div class="absolute inset-0 -z-10 bg-navy-900/35" aria-hidden="true"></div>

    <!-- Letra decorativa "DESDE 2012" — alude a fundación Cargoban -->
    <div
      aria-hidden="true"
      data-parallax="0.35"
      class="absolute -bottom-10 -right-4 pointer-events-none select-none font-display-xl text-[clamp(6rem,18vw,18rem)] leading-[0.8] text-white/[0.05] whitespace-nowrap"
    >
      DESDE 2012
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
      <!-- Bloque Movex Company CENTRADO (Jon 2026-05-27) -->
      <div class="max-w-3xl mx-auto">
        <!-- Label y título FUERA de la burbuja, centrados -->
        <div class="text-[11px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-6 text-center">
          ● Movex Company
        </div>
        <h2 data-split class="font-display-xl text-[clamp(2.5rem,6vw,5rem)] text-white leading-[0.95] mb-10 text-center">
          Movex <span class="text-teal-300">Company.</span>
        </h2>

        <!-- BUBBLE GLASS-PILL: párrafos centrados (Jon 2026-05-27) -->
        <div data-reveal="up" style="--reveal-delay:120ms" class="rounded-3xl bg-white/5 border border-white/15 backdrop-blur-sm shadow-[0_8px_32px_rgba(0,0,0,0.18)] p-8 sm:p-10 space-y-6 text-base sm:text-lg leading-relaxed text-white/90 text-center">
          <p>
            Heredamos la experiencia operativa de <strong class="text-white">Cargoban</strong>,
            operador logístico portuario referente en el Caribe colombiano desde 2012.
            Movex extiende ese músculo a una escala internacional.
          </p>
          <p>
            Trabajamos en estiba, consolidación, trazabilidad digital y agenciamiento aduanero —
            manejando carga general, refrigerada, granel y proyectos especiales.
          </p>
        </div>
      </div>

      <!-- Counter grid: 4 columns of numeric metrics -->
      <div class="mt-20 pt-12 border-t border-white/15 grid grid-cols-2 lg:grid-cols-4 gap-y-10 gap-x-6">
        {counters.map((c, i) => {
          const numeric = parseInt(String(c.value).replace(/\D/g, ""), 10);
          const animatable = isFinite(numeric) && numeric > 0;
          return (
            <div data-reveal="up" style={`--reveal-delay:${i * 100}ms`}>
              <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-teal-300 mb-3">
                0{i + 1}
              </div>
              <div class="font-display text-4xl sm:text-5xl text-white mb-2">
                {animatable ? <span data-countup={numeric}>0</span> : c.value}
              </div>
              <div class="text-xs text-white/55 leading-relaxed">{c.label}</div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Letra decorativa "POR QUÉ" — semi-transparente atrás de las advantages -->
  <div
    aria-hidden="true"
    data-parallax="0.3"
    class="absolute top-32 -left-4 pointer-events-none select-none font-display-xl text-[clamp(8rem,22vw,22rem)] leading-[0.8] text-navy-900/[0.04] whitespace-nowrap"
  >
    POR QUÉ
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10 grid lg:grid-cols-[1fr_1.4fr] gap-12 lg:gap-20">
    <!-- Left: sticky giant title + imagen de operación portuaria -->
    <div data-reveal="left" class="lg:sticky lg:top-32 lg:self-start">
      <div class="text-[11px] font-mono uppercase tracking-[0.25em] text-teal-500 mb-6">
        ● Por qué Movex
      </div>
      <h2 data-split class="font-display-xl text-[clamp(3rem,7vw,7rem)] text-navy-900 leading-[0.7] mb-8">
        Por qué <span class="text-teal-500">Movex.</span>
      </h2>
      <p class="text-base text-navy-700 leading-relaxed max-w-md">
        Lo que define cómo operamos y por qué los importadores y exportadores nos eligen para
        mover sus cargas estratégicas.
      </p>
    </div>

    <!-- Right: stacked cards -->
    <div class="space-y-4">
      {advantages.map((adv, i) => (
        <article data-reveal="right" style={`--reveal-delay:${i * 60}ms`} class="rounded-3xl bg-gray-100 p-8 sm:p-10 grid grid-cols-[auto_1fr_2fr] gap-6 items-start hover:bg-gray-100/80 transition-colors">
          <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-navy-500 pt-2">
            0{i + 1}/0{advantages.length}
          </div>
          <h3 class="font-display text-2xl sm:text-3xl text-navy-900 leading-tight">
            {adv.title}
          </h3>
          <p class="text-sm sm:text-base text-navy-700 leading-relaxed pt-1">
            {adv.body}
          </p>
        </article>
      ))}
    </div>
  </div>

  <!-- (Timeline "Nuestra historia" removido el 2026-05-27 por pedido de Jon) -->
</section>

<script>
  // Video Quienes Somos: corta el inicio (empieza en startTime) y loopea
  // desde ahí, no desde 0. Patrón inspirado en Hero.astro.
  (() => {
    const v = document.getElementById("quienes-somos-video") as HTMLVideoElement | null;
    if (!v) return;
    const startTime = parseFloat(v.dataset.startTime || "0");
    v.muted = true;
    v.playsInline = true;
    v.removeAttribute("loop");
    const goToStart = () => {
      try { v.currentTime = startTime; } catch (_) {}
    };
    v.addEventListener("loadedmetadata", goToStart, { once: true });
    if (v.readyState >= 1) goToStart();
    const tryPlay = () => v.play().catch(() => {
      const onGesture = () => { v.play().catch(()=>{}); cleanup(); };
      const cleanup = () => {
        ["click","touchstart","keydown","wheel"].forEach(ev =>
          window.removeEventListener(ev, onGesture)
        );
      };
      ["click","touchstart","keydown","wheel"].forEach(ev =>
        window.addEventListener(ev, onGesture, { once: true, passive: true })
      );
    });
    tryPlay();
    // Custom loop: cuando se acerca al final, vuelve a startTime
    v.addEventListener("timeupdate", () => {
      if (!v.duration || isNaN(v.duration)) return;
      if (v.currentTime >= v.duration - 0.15) {
        v.currentTime = startTime;
        v.play().catch(() => {});
      }
    });
  })();
</script>
