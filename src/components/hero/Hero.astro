---
import { brand } from "../../data/site";
---

<!--
  HERO simple — el barco protagonista + título + body + CTAs.
  Sin elementos extra. Solo: video, título grande, copy corto, CTAs.

  Scroll-stacking: el Hero queda pinned (sticky top:0) mientras la
  siguiente sección (SERVICIOS — ya no Empresa) sube sobre él con
  rounded-t-[40px] + bg-navy-900 + z-20.

  El "feel del referente" viene de las ANIMACIONES, no de copiar
  componentes visuales (Lenis lerp, easing soft, parallax tied).
-->
<div class="relative" style="height: 100vh">
<section id="hero" class="sticky top-0 left-0 right-0 isolate h-[100vh] flex flex-col overflow-hidden z-0 bg-navy-900">
  <!-- Background fallback (mientras carga el video) -->
  <div
    class="absolute inset-0 -z-30 bg-gradient-to-br from-navy-900 via-navy-700 to-navy-900"
    aria-hidden="true"
  >
    <div class="absolute inset-0 [background:radial-gradient(ellipse_at_55%_50%,rgba(45,138,138,0.35)_0%,transparent_55%)]"></div>
  </div>

  <!-- Background video PALINDROME (loop seamless con ffmpeg reverse).
       SCALE 1.35: el video se "zoom-in" 35% al centro → el barco se ve mucho
       más grande (igual MVP que tiene el camión enorme). El overflow-hidden
       del section recorta los bordes que sobresalen. -->
  <video
    id="hero-video"
    class="absolute inset-0 size-full object-cover -z-20 opacity-0 transition-opacity duration-700 ease-out"
    src="/assets/videos/cargo-ship-aerial-loop.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    style="transform: scale(1.35); transform-origin: center;"
  ></video>

  <!-- Overlay general más oscuro para legibilidad estilo Viamaster.
       Horizontal: izquierda más oscura (título), derecha también oscurecida (subtexto). -->
  <div
    class="absolute inset-0 -z-10 [background:linear-gradient(95deg,rgba(26,41,64,0.82)_0%,rgba(26,41,64,0.55)_30%,rgba(26,41,64,0.45)_60%,rgba(26,41,64,0.70)_100%)]"
    aria-hidden="true"
  ></div>
  <!-- Capa global sutil para reducir contraste del video y mejorar legibilidad -->
  <div
    class="absolute inset-0 -z-10 bg-navy-900/30"
    aria-hidden="true"
  ></div>
  <!-- Vignette inferior más extendido para fundir el barco con el fondo -->
  <div
    class="absolute inset-x-0 bottom-0 h-[60%] -z-10 [background:linear-gradient(to_top,rgba(26,41,64,0.75)_0%,rgba(26,41,64,0.25)_55%,transparent_100%)]"
    aria-hidden="true"
  ></div>

  <!--
    LAYOUT según las "zonas amarillas" del screenshot de Jon:
    - ZONA TOP-LEFT (arriba a la izquierda): brand label + título
    - ZONA CENTRO: vacía, deja ver el barco
    - ZONA BOTTOM-RIGHT (abajo a la derecha): párrafo + CTAs alineados der.
  -->
  <!-- LAYOUT:
       - Grid 2 cols x 2 rows
       - ROW 1 (auto, full width): vacío arriba (deja espacio para el nav)
       - ROW 2 LEFT: título centrado vertical, alineado izquierda
       - ROW 2 RIGHT: subtexto + CTAs centrados vertical, alineados a la derecha
       Esto pone el bloque derecho a la MISMA altura del título — "más arriba y a la derecha"
       que la versión bottom-right anterior. -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-10 h-full grid grid-cols-1 lg:grid-cols-2 grid-rows-[auto_1fr] gap-y-8 lg:gap-y-0 pt-24 pb-12">
    <!-- ROW 1: vacío arriba (col-span) -->
    <div class="lg:col-span-2"></div>

    <!-- ROW 2 LEFT: título -->
    <div class="flex items-center">
      <h1
        data-hero-entry="1"
        class="font-display-xl text-[clamp(2.8rem,7.5vw,6.5rem)] leading-[0.92] opacity-0"
      >
        <span data-split class="block text-white">Conectamos</span>
        <span data-split class="block text-white">tu carga</span>
        <span data-split="slow" class="block text-teal-300">con el mundo.</span>
      </h1>
    </div>

    <!-- ROW 2 RIGHT: subtexto + CTAs alineados a la derecha, centrados verticalmente -->
    <div class="flex items-center justify-end">
      <div class="max-w-xl text-right">
        <p
          data-hero-entry="2"
          class="text-base sm:text-lg leading-relaxed text-white/90 mb-8 opacity-0"
        >
          Soluciones logísticas, portuarias y digitales diseñadas para una operación más eficiente, conectada y precisa.
        </p>

        <div data-hero-entry="3" class="flex flex-wrap gap-4 justify-end opacity-0">
          <a
            href="#quienes-somos"
            class="inline-flex items-center justify-center min-w-[180px] rounded-full bg-teal-500 hover:bg-teal-300 text-navy-900 font-semibold px-7 py-4 text-base transition-all hover:scale-[1.03]"
          >
            Sobre Movex
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center min-w-[180px] rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md text-white font-semibold px-7 py-4 text-base transition-all border border-white/25"
          >
            Contáctanos
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint bottom-left -->
  <span class="absolute bottom-8 left-8 text-[10px] font-mono uppercase tracking-[0.3em] text-white/55 animate-pulse">
    Scroll ↓
  </span>
</section>
</div><!-- /hero pin space -->

<script>
  (() => {
    // ─────────────────────────────────────────────────────────────
    // 1) VIDEO autoplay robusto + loop seamless
    // ─────────────────────────────────────────────────────────────
    const v = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (v) {
      v.muted = true;
      v.playsInline = true;
      const fadeIn = () => v.classList.remove("opacity-0");
      v.addEventListener("canplay", fadeIn, { once: true });
      if (v.readyState >= 3) fadeIn();
      const tryPlay = () => v.play().catch(() => {
        const onGesture = () => { v.play().catch(()=>{}); cleanup(); };
        const cleanup = () => {
          ["click","touchstart","keydown","wheel"].forEach(ev =>
            window.removeEventListener(ev, onGesture)
          );
        };
        ["click","touchstart","keydown","wheel"].forEach(ev =>
          window.addEventListener(ev, onGesture, { once: true, passive: true })
        );
      });
      tryPlay();
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && v.paused) tryPlay();
      });
      // Loop seamless — reset 0.15s antes del final
      v.removeAttribute("loop");
      v.addEventListener("timeupdate", () => {
        if (!v.duration || isNaN(v.duration)) return;
        if (v.currentTime >= v.duration - 0.15) {
          v.currentTime = 0;
          v.play().catch(() => {});
        }
      });
    }

    // NOTA: La entry animation post-intro ahora la maneja GSAP en
    // src/scripts/intro-reveal.ts (timeline orquestado, mismo pattern
    // que MVP). El código viejo de CSS transitions + setTimeout fue
    // removido para evitar conflicto.

  })();
</script>
