---
import { brand } from "../../data/site";
---

<!--
  HERO simple — el barco protagonista + título + body + CTAs.
  Sin elementos extra. Solo: video, título grande, copy corto, CTAs.

  Scroll-stacking: el Hero queda pinned (sticky top:0) mientras la
  siguiente sección (SERVICIOS — ya no Empresa) sube sobre él con
  rounded-t-[40px] + bg-navy-900 + z-20.

  El "feel del referente" viene de las ANIMACIONES, no de copiar
  componentes visuales (Lenis lerp, easing soft, parallax tied).
-->
<div class="relative" style="height: 100vh">
<section id="hero" class="sticky top-0 left-0 right-0 isolate h-[100vh] flex flex-col overflow-hidden z-0 bg-navy-900">
  <!-- Background fallback (mientras carga el video) -->
  <div
    class="absolute inset-0 -z-30 bg-gradient-to-br from-navy-900 via-navy-700 to-navy-900"
    aria-hidden="true"
  >
    <div class="absolute inset-0 [background:radial-gradient(ellipse_at_55%_50%,rgba(45,138,138,0.35)_0%,transparent_55%)]"></div>
  </div>

  <!-- Background video — protagonista, parallax sutil al scrollear -->
  <video
    id="hero-video"
    class="absolute inset-0 size-full object-cover -z-20 opacity-0 transition-opacity duration-700 ease-out"
    src="/assets/videos/cargo-ship-aerial.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    data-parallax="0.15"
    data-parallax-from="page"
  ></video>

  <!-- Overlay SUTIL (no oculta el video como antes). Solo un degradado del
       lado izquierdo para que el texto sea legible. -->
  <div
    class="absolute inset-0 -z-10 [background:linear-gradient(95deg,rgba(26,41,64,0.78)_0%,rgba(26,41,64,0.55)_35%,rgba(26,41,64,0.15)_70%,rgba(26,41,64,0.35)_100%)]"
    aria-hidden="true"
  ></div>
  <!-- Vignette inferior sutil para que los CTAs/scroll hint se lean -->
  <div
    class="absolute inset-x-0 bottom-0 h-48 -z-10 [background:linear-gradient(to_top,rgba(26,41,64,0.7)_0%,transparent_100%)]"
    aria-hidden="true"
  ></div>

  <!-- Content: una sola columna, izquierda, espacioso. Sin distracciones. -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-10 h-full flex flex-col justify-center pt-24 pb-28">
    <div
      data-hero-entry="0"
      class="flex items-center gap-3 mb-8 opacity-0"
    >
      <span class="size-2 rounded-full bg-teal-500"></span>
      <span class="text-sm tracking-[0.05em] uppercase text-white font-mono">Movex International</span>
    </div>

    <h1
      data-hero-entry="1"
      class="font-display-xl text-[clamp(3rem,9vw,8rem)] leading-[0.92] mb-10 opacity-0 max-w-5xl"
    >
      <span data-split class="block text-white">Avance.</span>
      <span data-split="slow" class="block text-teal-300 italic">Movilidad global.</span>
    </h1>

    <p
      data-hero-entry="2"
      class="text-base sm:text-lg lg:text-xl leading-relaxed text-white/90 max-w-2xl mb-10 opacity-0"
    >
      Operador logístico portuario premium — desde Apartadó y Santa Marta
      hacia el mundo. Servicio integral, seguro y sin fricción.
    </p>

    <div data-hero-entry="3" class="flex flex-wrap gap-4 opacity-0">
      <a
        href="#empresa"
        class="inline-flex items-center justify-center min-w-[180px] rounded-full bg-teal-500 hover:bg-teal-300 text-navy-900 font-semibold px-7 py-4 text-base transition-all hover:scale-[1.03]"
      >
        Sobre Movex
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center justify-center min-w-[180px] rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md text-white font-semibold px-7 py-4 text-base transition-all border border-white/25"
      >
        Contáctanos
      </a>
    </div>
  </div>

  <!-- Scroll hint bottom-left -->
  <span class="absolute bottom-8 left-8 text-[10px] font-mono uppercase tracking-[0.3em] text-white/55 animate-pulse">
    Scroll ↓
  </span>
</section>
</div><!-- /hero pin space -->

<script>
  (() => {
    // ─────────────────────────────────────────────────────────────
    // 1) VIDEO autoplay robusto + loop seamless
    // ─────────────────────────────────────────────────────────────
    const v = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (v) {
      v.muted = true;
      v.playsInline = true;
      const fadeIn = () => v.classList.remove("opacity-0");
      v.addEventListener("canplay", fadeIn, { once: true });
      if (v.readyState >= 3) fadeIn();
      const tryPlay = () => v.play().catch(() => {
        const onGesture = () => { v.play().catch(()=>{}); cleanup(); };
        const cleanup = () => {
          ["click","touchstart","keydown","wheel"].forEach(ev =>
            window.removeEventListener(ev, onGesture)
          );
        };
        ["click","touchstart","keydown","wheel"].forEach(ev =>
          window.addEventListener(ev, onGesture, { once: true, passive: true })
        );
      });
      tryPlay();
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && v.paused) tryPlay();
      });
      // Loop seamless — reset 0.15s antes del final
      v.removeAttribute("loop");
      v.addEventListener("timeupdate", () => {
        if (!v.duration || isNaN(v.duration)) return;
        if (v.currentTime >= v.duration - 0.15) {
          v.currentTime = 0;
          v.play().catch(() => {});
        }
      });
    }

    // ─────────────────────────────────────────────────────────────
    // 2) ENTRY ANIMATION post-intro:
    //    Cuando termina el intro (evento mvx:intro-done), los
    //    elementos del hero hacen fade-in + slide-up con stagger.
    //    Si ya pasó la intro (sessionStorage), animar inmediato.
    // ─────────────────────────────────────────────────────────────
    const entryEls = document.querySelectorAll<HTMLElement>("[data-hero-entry]");
    const playEntry = () => {
      entryEls.forEach((el) => {
        const i = parseInt(el.dataset.heroEntry || "0", 10);
        const delay = 200 + i * 140;
        el.style.transition = "opacity 900ms cubic-bezier(0.16,1,0.3,1), transform 900ms cubic-bezier(0.16,1,0.3,1)";
        el.style.transitionDelay = delay + "ms";
        el.style.transform = "translateY(40px)";
        // Force reflow para que el initial state se aplique antes
        void el.offsetWidth;
        requestAnimationFrame(() => {
          el.style.opacity = "1";
          el.style.transform = "translateY(0)";
        });
      });
    };
    if (sessionStorage.getItem("mvx_intro_v6")) {
      playEntry();
    } else {
      window.addEventListener("mvx:intro-done", playEntry, { once: true });
    }

  })();
</script>
