---
import { brand } from "../../data/site";
---

<!--
  Técnica scroll-stacking (estilo MVP):
  - Hero envuelto en un "pin space" que ocupa 100vh.
  - El hero mismo es position:sticky top:0 h:100vh → se queda PEGADO al top
    del viewport mientras scrolleas, hasta que el pin space termina.
  - La siguiente sección (Empresa) tiene z-index mayor → sube TAPANDO al hero
    mientras éste sigue sticky.
  Resultado: video + título se quedan fijos, card de Empresa sube cubriéndolos.
-->
<div class="relative" style="height: 100vh">
<section id="hero" class="sticky top-0 left-0 right-0 isolate h-[100vh] flex flex-col overflow-hidden z-0 bg-navy-900">
  <!-- Background fallback: gradient navy + bokeh teal mientras el video carga -->
  <div
    class="absolute inset-0 -z-20 bg-gradient-to-br from-navy-900 via-navy-700 to-navy-900"
    aria-hidden="true"
  >
    <div class="absolute inset-0 [background:radial-gradient(ellipse_at_55%_50%,rgba(45,138,138,0.35)_0%,transparent_55%)]"></div>
  </div>
  <!-- Background video — aerial cargo ship. id="hero-video" para forzar play() vía JS -->
  <video
    id="hero-video"
    class="absolute inset-0 size-full object-cover -z-20 opacity-0 transition-opacity duration-700 ease-out"
    src="/assets/videos/cargo-ship-aerial.mp4"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>

  <!-- Layered overlays: gradient + bokeh + subtle vignette -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-navy-900/85 via-navy-900/55 to-navy-900/85"></div>
  <div class="absolute inset-0 -z-10 [background:radial-gradient(ellipse_at_75%_45%,rgba(45,138,138,0.18)_0%,transparent_55%)]"></div>

  <!--
    LAYOUT REORGANIZADO según feedback de Jon (zonas amarillas):
    - Título "Avance. Movilidad global." en TOP-LEFT (zona amarilla 1)
    - Párrafos + CTAs en BOTTOM-RIGHT (zona amarilla 2 diagonal)
    - Centro libre para que el barco se vea protagonista
  -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 lg:px-10 h-full grid grid-rows-[auto_1fr_auto] pt-28 pb-12">
    <!-- ZONA TOP-LEFT: brand label + headline compacto -->
    <div class="max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="size-2 rounded-full bg-teal-500"></span>
        <span class="text-sm tracking-[0.02em] text-white/90">Movex International</span>
      </div>
      <h1 class="font-display-xl text-[clamp(2.5rem,6.5vw,5.5rem)] leading-[0.95]">
        <span data-split class="block text-teal-300">Avance.</span>
        <span data-split="slow" class="block text-white">Movilidad global.</span>
      </h1>
    </div>

    <!-- ZONA CENTRO: libre para que el barco se vea -->
    <div></div>

    <!-- ZONA BOTTOM-RIGHT: párrafos resumidos + CTAs alineados a la derecha -->
    <div class="flex justify-end">
      <div class="max-w-xl text-right">
        <p class="text-base sm:text-lg leading-relaxed text-white/90 mb-8">
          Operador logístico portuario premium — desde Apartadó y Santa Marta hacia el mundo.
          Servicio integral, seguro y sin fricción.
        </p>
        <div class="flex flex-wrap gap-4 justify-end">
          <a
            href="#empresa"
            class="inline-flex items-center justify-center min-w-[180px] rounded-full bg-teal-500 hover:bg-teal-300 text-navy-900 font-semibold px-7 py-4 text-base transition-colors"
          >
            Sobre Movex
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center min-w-[180px] rounded-full bg-white/15 hover:bg-white/25 backdrop-blur text-white font-semibold px-7 py-4 text-base transition-colors border border-white/20"
          >
            Contáctanos
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint bottom-left (movido para no chocar con los CTAs del bottom-right) -->
  <span class="absolute bottom-6 left-8 text-[10px] font-mono uppercase tracking-[0.3em] text-white/45">
    Scroll ↓
  </span>

  <!-- Decorative corner cut, Viamaster aesthetic touch -->
  <div class="absolute bottom-0 right-0 w-32 h-32 -z-10 [clip-path:polygon(100%_0,100%_100%,0_100%)] bg-navy-900/60"></div>
</section>
</div><!-- /hero pin space -->

<script>
  // El video del hero a veces no autoplaya por la política de Chrome
  // (autoplay con sonido requiere user gesture; muted=true debería bastar
  // pero en producción + sticky el browser puede ignorarlo).
  // Estrategia:
  //   1. Marcar `muted=true` explícitamente vía JS (override cualquier cosa).
  //   2. Llamar play() en cuanto el componente monta.
  //   3. Hacer fade-in al primer frame cargado (canplay event).
  //   4. Si play() rechaza, reintentar en el primer interacción del usuario.
  (() => {
    const v = document.getElementById("hero-video") as HTMLVideoElement | null;
    if (!v) return;
    v.muted = true;
    v.playsInline = true;

    const fadeIn = () => v.classList.remove("opacity-0");
    v.addEventListener("canplay", fadeIn, { once: true });
    // Si ya está cargado antes de que enganchemos el listener
    if (v.readyState >= 3) fadeIn();

    const tryPlay = () => v.play().catch(() => {
      // Browser bloqueó el autoplay — esperar primer gesture del user
      const onGesture = () => { v.play().catch(()=>{}); cleanup(); };
      const cleanup = () => {
        ["click","touchstart","keydown","wheel"].forEach(ev =>
          window.removeEventListener(ev, onGesture)
        );
      };
      ["click","touchstart","keydown","wheel"].forEach(ev =>
        window.addEventListener(ev, onGesture, { once: true, passive: true })
      );
    });
    tryPlay();
    // Re-intentar si el usuario vuelve a la pestaña (browser a veces pausa)
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && v.paused) tryPlay();
    });

    // LOOP SEAMLESS: el atributo `loop` nativo del browser produce un salto
    // visible al final del video porque hace `currentTime=0` exactamente
    // en el último frame (cuando ya se ve el "end"). Truco: hacer el reset
    // 0.15s ANTES del final, así el cambio queda enmascarado dentro del
    // playback fluido — el cerebro no percibe el corte.
    v.removeAttribute("loop");
    v.addEventListener("timeupdate", () => {
      if (!v.duration || isNaN(v.duration)) return;
      if (v.currentTime >= v.duration - 0.15) {
        v.currentTime = 0;
        v.play().catch(() => {});
      }
    });
  })();
</script>
