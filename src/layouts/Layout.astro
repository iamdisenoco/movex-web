---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Movex — Avance & Movilidad",
  description = "Operador logístico portuario premium para carga internacional desde Apartadó y Santa Marta hacia el mundo.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1a2940" />
    <link rel="icon" type="image/svg+xml" href="/brand/movex-isotipo-black.svg" />
    <title>{title}</title>
    <script is:inline>
      // Set ANTES de paint inicial:
      //  1) Lock scroll mientras la intro corre.
      //  2) Marca html.intro-locked → CSS oculta el body hasta que React monta
      //     el Intro3D (evita FOUC: ver el sitio normal por unos ms antes
      //     de que arranque la animación).
      if (typeof window !== "undefined" && !sessionStorage.getItem("mvx_intro_v6")) {
        document.documentElement.classList.add("intro-locked");
      }
    </script>
    <style is:inline>
      /* FOUC guard: mientras intro está locked, escondemos el body original
         PERO dejamos visibles el cover Y el astro-island del Intro3D
         (donde React monta la animación). Sin :not(astro-island) la
         animación entera quedaba invisible. */
      html.intro-locked body > *:not(#intro-cover):not(astro-island) { visibility: hidden; }
      #intro-cover {
        position: fixed; inset: 0; z-index: 45; background: #1a2940;
        pointer-events: none; transition: opacity 400ms ease-out;
      }
      html:not(.intro-locked) #intro-cover { opacity: 0; pointer-events: none; }
      /* Tras 800ms sin intro-locked, removemos el cover del flow */
      html:not(.intro-locked) #intro-cover { animation: introCoverHide 0s linear 800ms forwards; }
      @keyframes introCoverHide { to { display: none; } }
    </style>
  </head>
  <body class="bg-navy-900 text-white antialiased">
    <!-- Cover SIEMPRE primero — visible desde el primer paint, antes de que
         React monte el Intro3D. Evita el flash del sitio normal. -->
    <div id="intro-cover" aria-hidden="true"></div>
    <slot />

    <!--
      Animation stack — bundled by Astro/Vite (resuelve 'lenis' bare import):
        1) Lenis smooth scroll
        2) SplitText reveal
        3) Parallax tied a scroll position
        4) IntersectionObserver classic reveal
        5) Nav ready post-intro
        6) Counter countup
    -->
    <script>
      import "../scripts/animation.ts";
    </script>
  </body>
</html>
